/tools/
# 本地临时目录（评估文档/大命令输出/调试 dump，不入库）
.scratch/
local-reports/

# 内网专用文档（本地保留，禁止上 github）
docs/internal/

# openssl CA serial artifact (generated)
deploy/certs/*.srl
# 密钥文件：*.secret.* 只匹配「.secret.」中缀，漏掉以 .secret 结尾的。
# enroll_token.secret 就属于后者——它一直躺在工作区里未被忽略，随时可能被误 add。
*.secret
deploy/certs/*.key
deploy/certs/*.crt

# generated & persisted agent enroll token (secret, do not commit)
deploy/certs/enroll_token.secret

# golangci-lint migrate 产生的备份；旧配置在 git 历史里可回溯，不需要留副本
.golangci.bck.yml
*.bck.yml

# 环境特有标识清单（供 no_production_identifiers_test 读取，不入库）
.production-identifiers
