name: mxcwpp-kafka

# 容器 stdout 日志轮转。
#
# json-file 驱动默认无上限：容器一旦进入错误刷屏，单个日志文件可以在数小时内
# 吃掉整块根盘，届时数据库停止写入、docker exec 也会因无空间而失败，连排查都做不了。
# 此处给所有服务设硬上限：单文件 100MB、保留 3 个 = 每容器 300MB 封顶。
# 应用自身的结构化日志另有 DataRoot/logs/<svc> 卷挂载，不受此影响。
x-logging: &default-logging
  driver: "json-file"
  options:
    max-size: "100m"
    max-file: "3"

services:
  kafka-1:
    image: {{ .KafkaImage }}
    container_name: mxcwpp-kafka-1
    restart: always
    logging: *default-logging
    network_mode: host
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:{{ index .KafkaPorts 0 }},CONTROLLER://0.0.0.0:19093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://{{ .KafkaHost }}:{{ index .KafkaPorts 0 }}
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:19093,2@localhost:29093,3@localhost:39093
      CLUSTER_ID: {{ .KafkaClusterID }}
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2
      KAFKA_OFFSETS_TOPIC_NUM_PARTITIONS: 6
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 2
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_DEFAULT_REPLICATION_FACTOR: 2
      KAFKA_MIN_INSYNC_REPLICAS: 1
      KAFKA_NUM_PARTITIONS: 6
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
      KAFKA_LOG_RETENTION_HOURS: 72
      # 按大小保留(每分区上限): 高频 eBPF 仅靠时间保留会在 72h 内撑满磁盘, 加 1GB/分区 上限
      KAFKA_LOG_RETENTION_BYTES: 1073741824
      KAFKA_MESSAGE_MAX_BYTES: 10485760
      TZ: {{ .Timezone }}
    volumes:
      - {{ .DataRoot }}/kafka-1:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:{{ index .KafkaPorts 0 }} > /dev/null 2>&1"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 30s

  kafka-2:
    image: {{ .KafkaImage }}
    container_name: mxcwpp-kafka-2
    restart: always
    logging: *default-logging
    network_mode: host
    environment:
      KAFKA_NODE_ID: 2
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:{{ index .KafkaPorts 1 }},CONTROLLER://0.0.0.0:29093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://{{ .KafkaHost }}:{{ index .KafkaPorts 1 }}
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:19093,2@localhost:29093,3@localhost:39093
      CLUSTER_ID: {{ .KafkaClusterID }}
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2
      KAFKA_OFFSETS_TOPIC_NUM_PARTITIONS: 6
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 2
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_DEFAULT_REPLICATION_FACTOR: 2
      KAFKA_MIN_INSYNC_REPLICAS: 1
      KAFKA_NUM_PARTITIONS: 6
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
      KAFKA_LOG_RETENTION_HOURS: 72
      # 按大小保留(每分区上限): 高频 eBPF 仅靠时间保留会在 72h 内撑满磁盘, 加 1GB/分区 上限
      KAFKA_LOG_RETENTION_BYTES: 1073741824
      KAFKA_MESSAGE_MAX_BYTES: 10485760
      TZ: {{ .Timezone }}
    volumes:
      - {{ .DataRoot }}/kafka-2:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:{{ index .KafkaPorts 1 }} > /dev/null 2>&1"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 30s

  kafka-3:
    image: {{ .KafkaImage }}
    container_name: mxcwpp-kafka-3
    restart: always
    logging: *default-logging
    network_mode: host
    environment:
      KAFKA_NODE_ID: 3
      KAFKA_PROCESS_ROLES: broker,controller
      KAFKA_LISTENERS: PLAINTEXT://0.0.0.0:{{ index .KafkaPorts 2 }},CONTROLLER://0.0.0.0:39093
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://{{ .KafkaHost }}:{{ index .KafkaPorts 2 }}
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT
      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER
      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@localhost:19093,2@localhost:29093,3@localhost:39093
      CLUSTER_ID: {{ .KafkaClusterID }}
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 2
      KAFKA_OFFSETS_TOPIC_NUM_PARTITIONS: 6
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 2
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_DEFAULT_REPLICATION_FACTOR: 2
      KAFKA_MIN_INSYNC_REPLICAS: 1
      KAFKA_NUM_PARTITIONS: 6
      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"
      KAFKA_LOG_RETENTION_HOURS: 72
      # 按大小保留(每分区上限): 高频 eBPF 仅靠时间保留会在 72h 内撑满磁盘, 加 1GB/分区 上限
      KAFKA_LOG_RETENTION_BYTES: 1073741824
      KAFKA_MESSAGE_MAX_BYTES: 10485760
      TZ: {{ .Timezone }}
    volumes:
      - {{ .DataRoot }}/kafka-3:/var/lib/kafka/data
    healthcheck:
      test: ["CMD-SHELL", "kafka-broker-api-versions --bootstrap-server localhost:{{ index .KafkaPorts 2 }} > /dev/null 2>&1"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 30s

  # ===== 主机资源指标 =====
  # 主机 CPU/内存/磁盘指标。每个节点都要有，缺一个该节点就是监控盲区——
  # 盘满时进程仍存活，只靠服务存活告警发现不了。
  # 监听 9101 而非默认 9100 —— consumer 的 metrics 端点已占用 9100。
  node-exporter:
    image: prom/node-exporter:v1.8.2
    container_name: mxcwpp-node-exporter
    restart: always
    logging: *default-logging
    network_mode: host
    pid: host
    command:
      - "--path.rootfs=/host"
      - "--web.listen-address=:9101"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|run)($|/)"
    volumes:
      - /:/host:ro,rslave
    environment:
      TZ: {{ .Timezone }}
